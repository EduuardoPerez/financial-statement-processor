[run]
source = .
omit =
    tests/*
    memory-bank/*
    input/*
    output/*
    expected_output/*
    demo_*.py
    uv.lock
    pyproject.toml
    .gitignore
    README*.md
    .clinerules

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    # Exclude main execution block
    if __name__ == "__main__":

[html]
directory = htmlcov
